# Copy this file to .env and paste your real Gemini key in.
#
# Get a key at https://aistudio.google.com/apikey
#
# IMPORTANT PRIVACY NOTE: a free Google AI Studio key is used by Google to
# improve their products by default (human reviewers may see submitted
# content). Fine for testing with fake/sample data. For real company data,
# use a paid Vertex AI key instead (same code works, just get the key from
# a billing-enabled Google Cloud project rather than AI Studio) — paid tiers
# do not train on your data.

GEMINI_API_KEY=paste-your-key-here

# App access password (locks the site so only your team can use it / your quota)
APP_PASSWORD=choose-a-password

# Any random string, used to sign session cookies
FLASK_SECRET_KEY=change-this-to-something-random
