# Copy this file to .env and paste your real Gemini key in.
# Get a key at https://aistudio.google.com/apikey
#
# PRIVACY NOTE: a free AI Studio key is used by Google to improve their products
# by default. Fine for testing with sample/fake data. For real company data, use
# a paid Vertex AI key instead (same code works, just get the key from a
# billing-enabled Google Cloud project rather than AI Studio).

GEMINI_API_KEY=paste-your-key-here
APP_PASSWORD=choose-a-password
FLASK_SECRET_KEY=change-this-to-something-random
